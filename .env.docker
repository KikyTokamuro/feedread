APP_NAME=FeedRead
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=feedread
DB_USERNAME=feedread
DB_PASSWORD=feedread

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# How often the scheduler refreshes every feed, in minutes.
FEED_REFRESH_INTERVAL_MINUTES=30

FEEDREAD_ADMIN_NAME=admin
FEEDREAD_ADMIN_EMAIL=admin@example.com
FEEDREAD_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
